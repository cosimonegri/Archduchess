{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-release",
      "displayName": "Ninja Release Build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug Build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-profile",
      "displayName": "Ninja Profile Build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Profile"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "profile",
      "configurePreset": "ninja-profile"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "profile",
      "configurePreset": "ninja-profile"
    }
  ]
}
